{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}",
        "env": {
            "PATH": "C:\\cygwin64\\bin;${env:PATH}"
        }
    },
    "tasks": [
        {
            "label": "Build Server GUI (Cygwin)",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-Wall",
                "-Wextra",
                "-Iinclude",
                "server/server_gui.c",
                "-o",
                "build/gui/server_gui.exe",
                "-mwindows",
                "-lgdi32",
                "-lpthread"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build Client GUI (Cygwin)",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-Wall",
                "-Wextra",
                "-Iinclude",
                "client/client_gui.c",
                "-o",
                "build/gui/client_gui.exe",
                "-mwindows",
                "-lgdi32",
                "-lpthread"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build All GUIs",
            "dependsOrder": "parallel",
            "dependsOn": [
                "Build Server GUI (Cygwin)",
                "Build Client GUI (Cygwin)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Server GUI",
            "type": "shell",
            "command": "start \"\" build\\gui\\server_gui.exe",
            "dependsOn": [
                "Build Server GUI (Cygwin)"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run Client GUI",
            "type": "shell",
            "command": "start \"\" build\\gui\\client_gui.exe",
            "dependsOn": [
                "Build Client GUI (Cygwin)"
            ],
            "problemMatcher": []
        },
    ]
}